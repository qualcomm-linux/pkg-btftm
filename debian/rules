#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_install:
ifeq ($(DEB_HOST_ARCH),arm64)
	mkdir -p $(CURDIR)/debian/btdiag/usr/bin
	cp -a btdiag/arm64/usr/bin/* $(CURDIR)/debian/btdiag/usr/bin/
	mkdir -p $(CURDIR)/debian/btftmdaemon/usr/bin
	cp -a btftmdaemon/arm64/usr/bin/* $(CURDIR)/debian/btftmdaemon/usr/bin/
endif
	:

# binaries are already stripped
override_dh_dwz: ;
