 ${shlibs:Depends},

Package: btftmdaemon
Architecture: arm64
Description: Qualcomm Bluetooth FTM daemon (BlueZ HCI socket variant)
 Bluetooth factory test mode daemon that talks to the BT controller over
 the BlueZ HCI user-channel socket and receives FTM commands over the
 Qualcomm diag command channel (USB) or a TCP/IP diag channel.
Depends:
 ${misc:Depends},
 ${shlibs:Depends},
